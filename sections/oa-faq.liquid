<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="oa-faq section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="oa-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="oa-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="oa-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <details class="oa-faq__item" {{ block.shopify_attributes }}>
            <summary class="oa-faq__question">
              <span class="oa-faq__question-text">{{ block.settings.question }}</span>
              <span class="oa-faq__icon" aria-hidden="true">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="oa-faq__answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .oa-faq__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 720px;
    /* left-aligned like every other section — the centered column broke the
       page's alignment rhythm (all other sections sit hard-left on the grid) */
    margin-inline: 0;
  }

  .oa-faq__heading {
    margin: 0;
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .oa-faq__list {
    display: flex;
    flex-direction: column;
  }

  .oa-faq__item {
    border-block-end: 1px solid var(--oa-border-glass, rgba(255, 255, 255, 0.1));
    /* Progressive enhancement: smooth open/close where supported */
    /* stylelint-disable-next-line plugin/no-unsupported-browser-features */
    interpolate-size: allow-keywords;
  }

  .oa-faq__item:first-child {
    border-block-start: 1px solid var(--oa-border-glass, rgba(255, 255, 255, 0.1));
  }

  .oa-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding-block: 16px;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .oa-faq__question::-webkit-details-marker {
    display: none;
  }

  .oa-faq__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--oa-accent, #f7be18);
    transition: transform 0.25s ease;
  }

  .oa-faq__icon svg {
    width: 100%;
    height: 100%;
  }

  .oa-faq__item[open] .oa-faq__icon {
    transform: rotate(45deg);
  }

  .oa-faq__answer {
    max-width: 60ch;
    padding-block-end: 20px;
    color: var(--oa-text-muted, rgba(255, 255, 255, 0.55));
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .oa-faq__answer p {
    margin: 0;
  }

  .oa-faq__answer p + p {
    margin-block-start: 0.75em;
  }

  .oa-faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    /* stylelint-disable-next-line plugin/no-unsupported-browser-features */
    transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
  }

  .oa-faq__item[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .oa-faq__item::details-content {
      transition: none;
    }

    .oa-faq__icon {
      transition: none;
    }
  }

  @media screen and (min-width: 750px) {
    .oa-faq__inner {
      gap: 32px;
    }

    .oa-faq__question {
      padding-block: 20px;
      font-size: 1.0625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OA — FAQ",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Najczęstsze pytania"
    },
    {
      "type": "header",
      "content": "Wygląd"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemat kolorów",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Odstępy"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Góra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Dół",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Pytanie i odpowiedź",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pytanie",
          "default": "Czy folia jest widoczna na lakierze?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Odpowiedź",
          "default": "<p>Folia jest transparentna i ma grubość ułamka milimetra. Po poprawnym montażu widać ją dopiero z bliska, pod ostrym kątem światła.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "OA — FAQ",
      "category": "OklejAuto",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Czy folia jest widoczna na lakierze?",
            "answer": "<p>Folia jest transparentna i ma grubość ułamka milimetra. Po poprawnym montażu widać ją dopiero z bliska, pod ostrym kątem światła. Lakier zachowuje swój kolor i połysk.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Czy folia zniszczy lakier przy zdejmowaniu?",
            "answer": "<p>Nie. Klej jest zaprojektowany tak, aby schodzić w całości razem z folią — bez śladów i bez naruszania fabrycznego lakieru. Chroniony fragment wygląda jak w dniu oklejenia.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Jak trudny jest montaż?",
            "answer": "<p>Każdy zestaw jest precyzyjnie docięty pod konkretny element, więc niczego nie trzeba przycinać. Montaż na mokro zajmuje od kilkunastu do kilkudziesięciu minut, a do zestawu dołączamy instrukcję krok po kroku.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Jak długo folia wytrzymuje?",
            "answer": "<p>Folia PPF zachowuje swoje właściwości przez lata codziennej eksploatacji. Jest odporna na żwir, sól drogową, myjnie i promieniowanie UV, a drobne rysy sama regeneruje pod wpływem ciepła.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Czy folia pasuje do każdego auta?",
            "answer": "<p>Tak — każdy zestaw docinamy na zamówienie pod markę, model i rocznik, które podajesz przy zakupie. Nie ma znaczenia, czy to nowe auto z salonu, czy kilkuletni egzemplarz.</p>"
          }
        }
      ]
    }
  ]
