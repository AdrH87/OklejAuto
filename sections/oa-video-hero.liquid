{% liquid
  assign poster = section.settings.poster_image

  assign cta_link = section.settings.cta_link
  if cta_link == blank
    assign cta_link = '#wybierz-element'
  endif

  case section.settings.section_height
    when 'medium'
      assign hero_height = '70svh'
    when 'large'
      assign hero_height = '85svh'
    else
      assign hero_height = '100svh'
  endcase
%}

<div
  class="oa-hero color-{{ section.settings.color_scheme }}"
  style="
    --oa-hero-min-height: {{ hero_height }};
    --oa-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="oa-hero__media" aria-hidden="true">
    {%- if poster != blank -%}
      {{
        poster
        | image_url: width: 2560
        | image_tag:
          width: poster.width,
          height: poster.height,
          widths: '750, 1100, 1500, 1920, 2560',
          sizes: '100vw',
          alt: '',
          class: 'oa-hero__poster',
          fetchpriority: 'high'
      }}
    {%- endif -%}

    {%- if section.settings.video != blank -%}
      {%- if poster != blank -%}
        {%- assign poster_url = poster | image_url: width: 1920 -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            poster: poster_url,
            class: 'oa-hero__video'
        }}
      {%- else -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'oa-hero__video'
        }}
      {%- endif -%}
    {%- elsif section.settings.video_url != blank -%}
      <video
        class="oa-hero__video"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        {% if poster != blank %}
          poster="{{ poster | image_url: width: 1920 }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>

  <div class="oa-hero__overlay" aria-hidden="true"></div>

  <div class="oa-hero__content section section--page-width">
    {%- if section.settings.heading != blank -%}
      <h1 class="oa-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="oa-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ cta_link }}" class="oa-hero__cta">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .oa-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: var(--oa-hero-min-height, 85svh);
    background-color: #111111;
    overflow: hidden;
  }

  .oa-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .oa-hero__poster,
  .oa-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .oa-hero__video {
    z-index: 1;
  }

  /* Dark gradient for text contrast — also the fallback when no media is set */
  .oa-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgb(17 17 17 / var(--oa-hero-overlay-opacity, 0.55)) 0%,
      rgb(17 17 17 / calc(var(--oa-hero-overlay-opacity, 0.55) * 0.5)) 45%,
      rgb(17 17 17 / calc(var(--oa-hero-overlay-opacity, 0.55) * 0.25)) 100%
    );
    pointer-events: none;
  }

  .oa-hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-block-start: var(--padding-block-start, 0);
    padding-block-end: var(--padding-block-end, 48px);
  }

  .oa-hero__heading {
    margin: 0;
    max-width: 14ch;
    color: rgb(255 255 255);
    font-size: clamp(2.25rem, 4.5vw + 1rem, 3.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .oa-hero__subheading {
    margin: 0;
    max-width: 44ch;
    color: rgb(255 255 255 / 0.75);
    font-size: clamp(1rem, 0.5vw + 0.875rem, 1.125rem);
    line-height: 1.5;
  }

  .oa-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-block-start: 8px;
    padding: 12px 32px;
    background-color: rgb(255 255 255);
    color: #111111;
    border-radius: var(--oa-radius-pill, 99px);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .oa-hero__cta:hover {
    opacity: 0.85;
  }

  .oa-hero__cta:active {
    transform: scale(0.98);
  }

  @media screen and (min-width: 750px) {
    .oa-hero__content {
      gap: 20px;
      padding-block-end: var(--padding-block-end, 72px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OA — Hero wideo",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Wideo w tle"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Wideo (z biblioteki Shopify)",
      "info": "Krótka, skompresowana pętla bez dźwięku. Gdy puste, pokazuje się obraz zastępczy."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Link MP4 (zewnętrzny)",
      "info": "Bezpośredni link do pliku .mp4. Używany tylko, gdy wideo z biblioteki jest puste."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Obraz zastępczy (poster)",
      "info": "Wyświetlany od razu przy ładowaniu strony i gdy brak wideo. Ważny dla szybkości (LCP)."
    },
    {
      "type": "header",
      "content": "Treść"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Niewidzialna ochrona, która pracuje za Ciebie"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Tekst pod nagłówkiem",
      "default": "Precyzyjnie docięte folie ochronne na najbardziej narażone elementy Twojego auta"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Tekst przycisku",
      "default": "Wybierz element"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link przycisku",
      "info": "Domyślnie przewija do karuzeli elementów (#wybierz-element)."
    },
    {
      "type": "header",
      "content": "Wygląd"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Wysokość sekcji",
      "options": [
        {
          "value": "medium",
          "label": "Średnia"
        },
        {
          "value": "large",
          "label": "Duża"
        },
        {
          "value": "full-screen",
          "label": "Pełny ekran"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Przyciemnienie tła",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemat kolorów",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "Odstępy"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Góra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Dół",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "OA — Hero wideo",
      "category": "OklejAuto",
      "settings": {
        "heading": "Niewidzialna ochrona, która pracuje za Ciebie",
        "subheading": "Precyzyjnie docięte folie ochronne na najbardziej narażone elementy Twojego auta",
        "cta_label": "Wybierz element",
        "section_height": "large",
        "overlay_opacity": 55,
        "color_scheme": "scheme-6"
      }
    }
  ]
}
{% endschema %}
