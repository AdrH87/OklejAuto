

{%- doc -%}
  OklejAuto bundle tier selector — "choose-your-own" model (v2).

  Three radio tap-tiles: "1 element" (the current element product, native
  form flow), "2 elementy −X%" and "4 elementy −Y%". The bundle tiers open
  a single fold-out panel (grid-rows 0fr -> 1fr) with checkbox chips — one
  per product of the configured collection (default: "elementy") — where the
  shopper picks EXACTLY 2 or 4 elements. The current product is pre-checked
  (and prepended as the first chip when it's not part of the collection).

  Pricing: the panel summary, the main price block and the ATC button label
  show sum(checked chips) × (1 − tier%) — computed live in JS from the
  chips' data-price (cents) and formatted with the theme's money-formatting
  module (shop.money_format + ISO currency ride in as data attributes).
  The actual discount is applied in the cart by Shopify automatic discounts
  (min 2 / min 4 items from the collection) — the PDP only previews it,
  so the X/Y settings here MUST match the discounts configured in admin.

  Add to cart: tier 1 uses the theme's native single-product flow untouched.
  Bundle tiers intercept the form submit and POST /cart/add.js with items[]
  (one line per chip, quantity 1, vehicle properties on every line), then
  fire the exact same events the theme's product form fires after an add.

  The old `oklejauto.pakiety` / `oklejauto.sklad` metafields are no longer
  read — predefined Pakiet products are retired.

  Graceful degradation: fewer than 2 chips available -> the block renders
  nothing (a setup hint is shown in the theme editor only) and the plain
  ATC works. Logic: assets/oa-bundle-tier-selector.js
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign radio_group_name = 'oa-tier-' | append: block.id

  assign chips_collection = block_settings.collection
  if chips_collection == blank
    assign chips_collection = collections['elementy']
  endif

  assign discount_pct_2 = block_settings.discount_pct_2 | default: 10
  assign discount_pct_4 = block_settings.discount_pct_4 | default: 20

  assign label_tier_1 = block_settings.label_tier_1 | default: '1 element'
  assign label_tier_2 = block_settings.label_tier_2 | default: '2 elementy'
  assign label_tier_3 = block_settings.label_tier_3 | default: '4 elementy'
  assign label_separate = block_settings.label_separate | default: 'Osobno'
  assign label_with_discount = block_settings.label_with_discount | default: 'Z rabatem'
  assign label_counter = block_settings.label_counter | default: 'Wybrano'

  assign current_in_collection = false
  assign chip_count = 0
  for chip_product in chips_collection.products
    assign chip_count = chip_count | plus: 1
    if chip_product.id == product.id
      assign current_in_collection = true
    endif
  endfor
  if current_in_collection == false and product != blank
    assign chip_count = chip_count | plus: 1
  endif

  assign initial_checked = 0
  if current_variant.available
    assign initial_checked = 1
  endif
-%}

{%- if product != blank and chip_count >= 2 -%}
  <oa-bundle-tier-selector
    class="oa-tier-selector spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-block-id="{{ block.id }}"
    data-product-form-id="{{ product_form_id }}"
    data-vehicle-keys="{{ block_settings.vehicle_keys | escape }}"
    data-attribute-key="{{ block_settings.attribute_key | default: 'vehicle' | escape }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-currency="{{ localization.country.currency.iso_code }}"
    data-error-text="Nie udało się dodać do koszyka. Spróbuj ponownie."
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <p
        class="oa-tier-selector__heading"
        id="OaTierHeading-{{ block.id }}"
      >
        {{ block_settings.heading | escape }}
      </p>
    {%- endif -%}

    {%- if block_settings.social_proof_text != blank -%}
      <p class="oa-tier-selector__proof oa-muted">{{ block_settings.social_proof_text | escape }}</p>
    {%- endif -%}

    <div
      class="oa-tier-selector__group"
      role="radiogroup"
      {% if block_settings.heading != blank %}
        aria-labelledby="OaTierHeading-{{ block.id }}"
      {% else %}
        aria-label="Wybierz zakres ochrony"
      {% endif %}
    >
      <label class="oa-tier oa-glass">
        {%- comment -%}
          Tier 1 owns nothing: the theme's native variant flow keeps the
          form's hidden input and the price display at all times.
        {%- endcomment -%}
        <input
          type="radio"
          class="oa-tier__input visually-hidden"
          name="{{ radio_group_name }}"
          data-tier="single"
          checked
          on:change="/handleTierChange"
        >
        <span class="oa-tier__name">{{ label_tier_1 | escape }}</span>
        <span class="oa-tier__price" data-tier-price="current">{{ current_variant.price | money }}</span>
      </label>

      {%- assign tier_2_disabled = false -%}
      {%- if chip_count < 2 -%}{%- assign tier_2_disabled = true -%}{%- endif -%}
      <label class="oa-tier oa-glass{% if tier_2_disabled %} oa-tier--unavailable{% endif %}">
        <input
          type="radio"
          class="oa-tier__input visually-hidden"
          name="{{ radio_group_name }}"
          data-tier="bundle"
          data-required="2"
          data-discount-pct="{{ discount_pct_2 }}"
          {% if tier_2_disabled %}
            disabled
          {% endif %}
          on:change="/handleTierChange"
        >
        {%- if block_settings.badge_2 != blank and tier_2_disabled == false -%}
          <span class="oa-tier__flag">{{ block_settings.badge_2 | escape }}</span>
        {%- endif -%}
        <span class="oa-tier__name">{{ label_tier_2 | escape }}</span>
        {%- if discount_pct_2 > 0 -%}
          <span class="oa-tier__discount">−{{ discount_pct_2 }}%</span>
        {%- endif -%}
      </label>

      {%- assign tier_4_disabled = false -%}
      {%- if chip_count < 4 -%}{%- assign tier_4_disabled = true -%}{%- endif -%}
      <label class="oa-tier oa-glass{% if tier_4_disabled %} oa-tier--unavailable{% endif %}">
        <input
          type="radio"
          class="oa-tier__input visually-hidden"
          name="{{ radio_group_name }}"
          data-tier="bundle"
          data-required="4"
          data-discount-pct="{{ discount_pct_4 }}"
          {% if tier_4_disabled %}
            disabled
          {% endif %}
          on:change="/handleTierChange"
        >
        {%- if block_settings.badge_3 != blank and tier_4_disabled == false -%}
          <span class="oa-tier__flag">{{ block_settings.badge_3 | escape }}</span>
        {%- endif -%}
        <span class="oa-tier__name">{{ label_tier_3 | escape }}</span>
        {%- if discount_pct_4 > 0 -%}
          <span class="oa-tier__discount">−{{ discount_pct_4 }}%</span>
        {%- endif -%}
      </label>
    </div>

    {%- comment -%}
      One shared fold-out panel for both bundle tiers — chip picks survive
      switching 2 <-> 4. The JS toggles data-open and fills counter/sums.
    {%- endcomment -%}
    <div
      class="oa-tier-panel"
      data-tier-panel
      aria-hidden="true"
    >
      <div class="oa-tier-panel__clip">
        <div class="oa-tier-panel__card oa-glass">
          <p
            class="oa-tier-panel__counter"
            aria-live="polite"
          >
            {{ label_counter | escape }} <span data-count>{{ initial_checked }}</span> z <span data-required-count>2</span>
          </p>

          <div class="oa-chip-grid">
            {%- unless current_in_collection -%}
              <label class="oa-chip oa-glass{% unless current_variant.available %} oa-chip--unavailable{% endunless %}">
                <input
                  type="checkbox"
                  class="oa-chip__input visually-hidden"
                  data-chip
                  data-variant-id="{{ current_variant.id }}"
                  data-price="{{ current_variant.price }}"
                  {% if current_variant.available %}
                    checked
                    data-current-checked="true"
                  {% else %}
                    data-current-checked="false"
                    data-unavailable="true"
                    disabled
                  {% endif %}
                  on:change="/handleChipChange"
                >
                <span class="oa-chip__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
                <span class="oa-chip__body">
                  <span class="oa-chip__name">{{ product.title | split: ' — ' | first | escape }}</span>
                  <span class="oa-chip__price oa-muted">
                    {%- if current_variant.available -%}
                      {{- current_variant.price | money -}}
                    {%- else -%}
                      Niedostępny
                    {%- endif -%}
                  </span>
                </span>
              </label>
            {%- endunless -%}

            {%- for chip_product in chips_collection.products -%}
              {%- liquid
                if chip_product.id == product.id
                  assign chip_variant = current_variant
                else
                  assign chip_variant = chip_product.selected_or_first_available_variant
                endif
                if chip_variant == blank
                  continue
                endif
                assign chip_is_current = false
                if chip_product.id == product.id
                  assign chip_is_current = true
                endif
              -%}
              <label class="oa-chip oa-glass{% unless chip_variant.available %} oa-chip--unavailable{% endunless %}">
                <input
                  type="checkbox"
                  class="oa-chip__input visually-hidden"
                  data-chip
                  data-variant-id="{{ chip_variant.id }}"
                  data-price="{{ chip_variant.price }}"
                  {% if chip_is_current and chip_variant.available %}
                    checked
                    data-current-checked="true"
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                  {% unless chip_variant.available %}
                    data-unavailable="true"
                    disabled
                  {% endunless %}
                  on:change="/handleChipChange"
                >
                <span class="oa-chip__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
                <span class="oa-chip__body">
                  <span class="oa-chip__name">{{ chip_product.title | split: ' — ' | first | escape }}</span>
                  <span class="oa-chip__price oa-muted">
                    {%- if chip_variant.available -%}
                      {{- chip_variant.price | money -}}
                    {%- else -%}
                      Niedostępny
                    {%- endif -%}
                  </span>
                </span>
              </label>
            {%- endfor -%}
          </div>

          <div class="oa-tier-panel__totals">
            <p
              class="oa-tier-panel__separate oa-muted"
              data-line-separate
            >
              <span aria-hidden="true">{{ label_separate | escape }}: <s data-sum-separate></s></span>
              <span class="visually-hidden">{{ label_separate | escape }}: <span data-sum-separate-sr></span></span>
            </p>
            <p class="oa-tier-panel__bundle">
              {{ label_with_discount | escape }}
              <span class="oa-tier-panel__pct" data-discount-pct-text>−{{ discount_pct_2 }}%</span>:
              <strong data-sum-discounted></strong>
            </p>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%}
      Price fragments.

      1. data-button-price-for="current": server-rendered ATC label price for
         tier 1, refreshed from section renders on variant:update (v1 pattern).
      2. data-bundle-atc-price: skeleton for the computed bundle ATC label —
         amounts are filled in JS (formatMoney), structure stays Liquid-owned.
      3. data-bundle-price: skeleton copied as CHILDREN into the live
         [ref="priceContainer"] — it must never contain its own
         ref="priceContainer" (one live ref in the DOM at all times).
    {%- endcomment -%}
    <template data-button-price-for="current">
      <span class="oa-atc-price">
        <span aria-hidden="true">—</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s
            class="oa-atc-price__compare"
            aria-hidden="true"
          >{{ current_variant.compare_at_price | money }}</s>
        {%- endif %}
        <span class="oa-atc-price__amount"><span class="visually-hidden">Cena:&nbsp;</span>{{ current_variant.price | money }}</span>
      </span>
    </template>
    <template data-bundle-atc-price>
      <span class="oa-atc-price">
        <span aria-hidden="true">—</span>
        <s
          class="oa-atc-price__compare"
          aria-hidden="true"
          data-bundle-compare
        ></s>
        <span class="oa-atc-price__amount"><span class="visually-hidden">Cena:&nbsp;</span><span data-bundle-total></span></span>
      </span>
    </template>
    <template data-bundle-price>
      <div class="price__sale">
        <span class="price-item__group">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <span class="price-item--sale price" data-bundle-total></span>
        </span>
        <span class="price-item__group" data-bundle-compare-group>
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <span class="price-item--regular compare-at-price" data-bundle-compare></span>
        </span>
      </div>
    </template>
  </oa-bundle-tier-selector>

  <script
    src="{{ 'oa-bundle-tier-selector.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- elsif request.design_mode -%}
  <div
    class="oa-tier-selector__editor-hint oa-muted"
    {{ block.shopify_attributes }}
  >
    Selektor pakietów: wybierz kolekcję elementów (domyślnie „elementy”) z co najmniej 2 dostępnymi produktami, aby pokazać kafelki 1 / 2 / 4. Pamiętaj o automatic discounts w adminie (min. 2 szt → rabat 2 elementów, min. 4 szt → rabat 4 elementów). Bez kolekcji blok nie renderuje niczego, a zwykły przycisk „Dodaj do koszyka” działa normalnie.
  </div>
{%- endif -%}

{% stylesheet %}
  .oa-tier-selector {
    display: block;
    width: 100%;
    min-width: 0;
  }

  .oa-tier-selector__heading {
    margin-block: 0;
    margin-inline: 0;
    font-weight: var(--font-weight-semibold, 600);
  }

  .oa-tier-selector__proof {
    margin-block: 2px 0;
    margin-inline: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  /* Three fixed columns at every width: tier labels are short ("2 elementy"),
     so three ~100px tiles fit a 375px viewport without wrapping rows. */
  .oa-tier-selector__group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-xs);
    padding-block-start: 10px; /* room for the overlapping flags */
    margin-block-start: var(--gap-xs);
  }

  .oa-tier {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 64px;
    min-width: 0;
    padding: var(--padding-sm) var(--padding-2xs);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .oa-tier:hover {
    border-color: rgb(255 255 255 / 0.3);
  }

  /* Selected: white border + subtle gold ring */
  .oa-tier:has(.oa-tier__input:checked) {
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--oa-accent) 22%, transparent);
  }

  .oa-tier:has(.oa-tier__input:focus-visible) {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: 2px;
  }

  .oa-tier--unavailable {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Overflow hardening: the flag may never grow past its tile's track
     (+8px grace), no matter how long the merchant's badge text is —
     long values ellipsize instead of colliding with the neighbor flag.
     Mobile-first: tighter font/padding, relaxed from 480px up. */
  .oa-tier__flag {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -55%);
    max-width: calc(100% + 8px);
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0.15em 0.55em;
    background: var(--oa-accent);
    border-radius: var(--oa-radius-pill);
    color: #111111;
    font-size: 0.5625rem;
    font-weight: var(--font-weight-semibold, 600);
    line-height: 1.5;
    white-space: nowrap;
  }

  @media screen and (min-width: 480px) {
    .oa-tier__flag {
      padding: 0.15em 0.7em;
      font-size: 0.625rem;
    }
  }

  .oa-tier__name {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold, 600);
    line-height: 1.25;
    overflow-wrap: break-word;
    min-width: 0;
    max-width: 100%;
  }

  .oa-tier__price {
    font-size: 0.8125rem;
    line-height: 1.25;
    color: var(--oa-text-muted);
  }

  .oa-tier:has(.oa-tier__input:checked) .oa-tier__price {
    color: var(--color-foreground);
  }

  /* Discount line on bundle tiles — gold, sparingly */
  .oa-tier__discount {
    font-size: 0.8125rem;
    line-height: 1.25;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--oa-accent);
  }

  /* Fold-open panel: grid-rows 0fr -> 1fr keyed off data-open,
     toggled by the component JS when a bundle tile is selected. */
  .oa-tier-panel {
    display: grid;
    grid-template-rows: 0fr;
  }

  .oa-tier-panel[data-open='true'] {
    grid-template-rows: 1fr;
  }

  @media (prefers-reduced-motion: no-preference) {
    .oa-tier-panel {
      transition: grid-template-rows 0.3s var(--ease-out-quad, ease);
    }
  }

  .oa-tier-panel__clip {
    overflow: hidden;
    min-height: 0;
    /* visibility keeps the collapsed panel out of the a11y tree and tab
       order (overflow:hidden alone leaves chips focusable at 0 height) */
    visibility: hidden;
    transition: visibility 0.3s;
  }

  .oa-tier-panel[data-open='true'] .oa-tier-panel__clip {
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .oa-tier-panel__clip {
      transition: none;
    }
  }

  .oa-tier-panel__card {
    margin-block-start: var(--gap-sm);
    padding: var(--padding-md) var(--padding-md);
  }

  .oa-tier-panel__counter {
    margin: 0 0 var(--padding-sm);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold, 600);
  }

  /* Element chips: 2-up on a 375px viewport, fluid above */
  .oa-chip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--gap-xs);
  }

  .oa-chip {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    min-height: 48px; /* touch target */
    min-width: 0;
    padding: var(--padding-2xs) var(--padding-xs);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .oa-chip:hover {
    border-color: rgb(255 255 255 / 0.3);
  }

  .oa-chip:has(.oa-chip__input:checked) {
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--oa-accent) 22%, transparent);
  }

  .oa-chip:has(.oa-chip__input:focus-visible) {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: 2px;
  }

  /* Covers both unavailable products and cap-locked chips (count reached) */
  .oa-chip:has(.oa-chip__input:disabled:not(:checked)) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .oa-chip__check {
    --icon-stroke-width: 2.5px;

    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid var(--oa-border-glass);
    border-radius: 5px;
    color: #111111;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .oa-chip__check svg {
    width: 12px;
    height: 12px;
    opacity: 0;
  }

  .oa-chip:has(.oa-chip__input:checked) .oa-chip__check {
    background: var(--oa-accent);
    border-color: var(--oa-accent);
  }

  .oa-chip:has(.oa-chip__input:checked) .oa-chip__check svg {
    opacity: 1;
  }

  .oa-chip__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .oa-chip__name {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold, 600);
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  .oa-chip__price {
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .oa-tier-panel__totals {
    margin-block-start: var(--padding-sm);
    padding-block-start: var(--padding-sm);
    border-top: 1px solid var(--oa-border-glass);
  }

  .oa-tier-panel__separate {
    margin: 0;
    font-size: 0.8125rem;
  }

  .oa-tier-panel__bundle {
    margin: 2px 0 0;
    font-size: 0.875rem;
  }

  .oa-tier-panel__bundle strong {
    font-weight: var(--font-weight-semibold, 600);
  }

  .oa-tier-panel__pct {
    color: var(--oa-accent);
    font-weight: var(--font-weight-semibold, 600);
  }

  /* Price fragment injected into the add-to-cart button label */
  .oa-atc-price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin-inline-start: 0.4em;
  }

  .oa-atc-price__compare {
    opacity: 0.6;
    font-weight: var(--font-weight-normal, 400);
  }

  .oa-atc-price__amount {
    font-weight: var(--font-weight-semibold, 600);
  }

  .oa-tier-selector__editor-hint {
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OA — Wybór pakietu",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Tiery 1 / 2 / 4: klient sam wybiera elementy z kolekcji (chipsy). Cena na stronie produktu jest wyliczana poglądowo — rabat nalicza się w koszyku."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek (etykieta zakresu)",
      "default": "Wybierz zakres ochrony"
    },
    {
      "type": "text",
      "id": "social_proof_text",
      "label": "Linia social proof",
      "default": "Najczęściej wybierane: 2 elementy"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekcja elementów",
      "info": "Gdy nie wybrano — używana jest kolekcja „elementy”."
    },
    {
      "type": "header",
      "content": "Rabaty"
    },
    {
      "type": "range",
      "id": "discount_pct_2",
      "label": "Rabat: 2 elementy (%)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "discount_pct_4",
      "label": "Rabat: 4 elementy (%)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "paragraph",
      "content": "Uwaga: rabaty % muszą odpowiadać automatic discounts w adminie Shopify (Pakiet 2+/4+)."
