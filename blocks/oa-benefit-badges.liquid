

{%- doc -%}
  OklejAuto benefit badges (TryScent PDP pattern).

  Three compact icon + label cards reinforcing the product promise.

  Mobile / tablet (<990px): three full-width rows rendered in normal flow.
  Placed as the FIRST block of the details column, they appear directly
  under the product image on mobile.

  Desktop (>=990px): the list becomes a vertical rail overlaid along the
  RIGHT EDGE of the gallery image. Mechanism: the block root collapses to
  height 0 (so it doesn't push the buy box down) and the list is positioned
  absolutely at `right: calc(100% + offset)` — i.e. just left of the details
  column, which lands on the gallery's right edge. No theme gallery files
  are touched, so the overlay survives gallery setting changes.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
-%}

<div
  class="oa-benefit-badges spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <ul
    class="oa-benefit-badges__list"
    role="list"
  >
    {%- for index in (1..3) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: index
        assign label_key = 'label_' | append: index
        assign item_icon = block_settings[icon_key]
        assign item_label = block_settings[label_key]
      -%}
      {%- if item_label != blank -%}
        <li class="oa-benefit-badges__item oa-glass">
          {%- if item_icon != 'none' -%}
            <svg
              class="oa-benefit-badges__icon icon-default"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 20 20"
            >
              {%- render 'icon', icon: item_icon -%}
            </svg>
          {%- endif -%}
          <span class="oa-benefit-badges__label">{{ item_label | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .oa-benefit-badges {
    width: 100%;
    min-width: 0;
  }

  .oa-benefit-badges__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile-first: compact full-width rows (icon left, label right) */
  .oa-benefit-badges__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    min-width: 0;
    padding: var(--padding-sm) var(--padding-md);
  }

  .oa-benefit-badges__icon {
    flex-shrink: 0;
    fill: currentcolor;
    color: var(--oa-accent);
  }

  .oa-benefit-badges__label {
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: var(--font-weight-medium, 500);
    overflow-wrap: break-word;
    min-width: 0;
  }

  /* Desktop: vertical rail overlaid on the gallery's right edge.
     Height collapses to 0 so the rail doesn't consume buy-box flow. */
  @media screen and (min-width: 990px) {
    .oa-benefit-badges {
      position: relative;
      height: 0;
      overflow: visible;
    }

    .oa-benefit-badges__list {
      position: absolute;
      top: var(--padding-md);
      right: calc(100% + 40px);
      width: 176px;
      gap: var(--gap-sm);
      z-index: 2;
    }

    .oa-benefit-badges__item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap-xs);
      padding: var(--padding-md);
      /* Legibility on top of photography: darken + blur behind the glass */
      background: rgb(17 17 17 / 0.72);
      backdrop-filter: blur(6px);
    }
  }
{% endstylesheet %}

