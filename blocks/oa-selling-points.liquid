

{%- liquid
  assign block_settings = block.settings
-%}

<div
  class="oa-selling-points spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <ul
    class="oa-selling-points__list"
    role="list"
  >
    {%- for index in (1..4) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: index
        assign label_key = 'label_' | append: index
        assign item_icon = block_settings[icon_key]
        assign item_label = block_settings[label_key]
      -%}
      {%- if item_label != blank -%}
        <li class="oa-selling-points__item oa-pill">
          {%- if item_icon != 'none' -%}
            <svg
              class="oa-selling-points__icon icon-default"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 20 20"
            >
              {%- render 'icon', icon: item_icon -%}
            </svg>
          {%- endif -%}
          <span class="oa-selling-points__label">{{ item_label | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .oa-selling-points {
    width: 100%;
    min-width: 0;
  }

  /* Mobile first: single scrollable row of glass pills */
  .oa-selling-points__list {
    display: flex;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .oa-selling-points__list::-webkit-scrollbar {
    display: none;
  }

  .oa-selling-points__item {
    flex: 0 0 auto;
    min-height: 44px;
    white-space: nowrap;
  }

  .oa-selling-points__icon {
    flex-shrink: 0;
    fill: currentcolor;
    color: var(--oa-accent);
  }

  .oa-selling-points__label {
    color: var(--color-foreground);
  }

  /* Desktop: wrap into two rows instead of scrolling */
  @media screen and (min-width: 750px) {
    .oa-selling-points__list {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
{% endstylesheet %}

