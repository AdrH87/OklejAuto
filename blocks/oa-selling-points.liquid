

{%- liquid
  assign block_settings = block.settings
-%}

<div
  class="oa-selling-points spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <ul
    class="oa-selling-points__list"
    role="list"
  >
    {%- for index in (1..5) -%}
      {%- liquid
        assign icon_key = 'icon_' | append: index
        assign label_key = 'label_' | append: index
        assign item_icon = block_settings[icon_key]
        assign item_label = block_settings[label_key]
      -%}
      {%- if item_label != blank -%}
        <li class="oa-selling-points__item">
          {%- if item_icon != 'none' -%}
            <svg
              class="oa-selling-points__icon icon-default"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 20 20"
            >
              {%- render 'icon', icon: item_icon -%}
            </svg>
          {%- endif -%}
          <span class="oa-selling-points__label">{{ item_label | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .oa-selling-points {
    width: 100%;
    min-width: 0;
  }

  /* Attribute row (up to 5 items): icon above label. Flex-wrap with equal
     item widths — 5-up compact on desktop, 2 per row on narrow viewports
     (2+2+1 with the odd item centered). Never scrolls or crops. */
  .oa-selling-points__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-sm) var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oa-selling-points__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    flex: 0 0 calc((100% - var(--gap-xs)) / 2);
    min-width: 0;
    text-align: center;
  }

  .oa-selling-points__icon {
    flex-shrink: 0;
    fill: currentcolor;
    color: var(--oa-accent);
  }

  .oa-selling-points__label {
    color: var(--color-foreground);
    font-size: 0.75rem;
    line-height: 1.3;
    overflow-wrap: break-word;
    min-width: 0;
  }

  @media screen and (min-width: 480px) {
    .oa-selling-points__item {
      flex-basis: calc((100% - 4 * var(--gap-xs)) / 5);
    }
  }
{% endstylesheet %}

