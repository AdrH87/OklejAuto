

{%- doc -%}
  OklejAuto USP line (TryScent "inspired by" pattern).

  One short icon + text line directly under the review stars, carrying the
  core promise (default: "Docinana pod Twoje auto — montaż w kilka minut").
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
-%}

{%- if block_settings.text != blank -%}
  <div
    class="oa-usp-line spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.icon != 'none' -%}
      <svg
        class="oa-usp-line__icon icon-default"
        aria-hidden="true"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 20 20"
      >
        {%- render 'icon', icon: block_settings.icon -%}
      </svg>
    {%- endif -%}
    <p class="oa-usp-line__text">{{ block_settings.text | escape }}</p>
  </div>
{%- endif -%}

{% stylesheet %}
  .oa-usp-line {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    min-width: 0;
  }

  .oa-usp-line__icon {
    flex-shrink: 0;
    fill: currentcolor;
    color: var(--oa-accent);
  }

  .oa-usp-line__text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    font-weight: var(--font-weight-medium, 500);
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "OA — Linia USP",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Ikona",
      "options": [
        { "value": "none", "label": "Brak" },
        { "value": "ruler", "label": "Linijka" },
        { "value": "stopwatch", "label": "Stoper" },
        { "value": "lightning_bolt", "label": "Błyskawica" },
        { "value": "check_box", "label": "Potwierdzenie" },
        { "value": "star", "label": "Gwiazdka" },
        { "value": "recycle", "label": "Regeneracja" },
        { "value": "eye", "label": "Oko" },
        { "value": "truck", "label": "Dostawa" },
        { "value": "return", "label": "Zwrot" }
      ],
      "default": "ruler"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Tekst",
      "default": "Docinana pod Twoje auto — montaż w kilka minut"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "OA — Linia USP",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
